function drawSkyGradient(c, colors) {
  const g = c.createLinearGradient(0,0,0,H);
  colors.forEach((col,i)=>g.addColorStop(i/(colors.length-1), col));
  c.fillStyle = g; c.fillRect(0,0,W,H);
}
function drawSun(c, x, y, r, color='#fff9c4', glowColor='#ffe082') {
  const sg = c.createRadialGradient(x,y,r*0.15,x,y,r);
  sg.addColorStop(0,color); sg.addColorStop(0.5,glowColor); sg.addColorStop(1,'rgba(255,224,130,0)');
  c.fillStyle = sg; c.beginPath(); c.arc(x,y,r,0,Math.PI*2); c.fill();
}
function drawMountain(c, cx, cy, w, h, color, snow=false) {
  c.fillStyle = color;
  c.beginPath();
  c.moveTo(cx-w, cy); c.lineTo(cx, cy-h); c.lineTo(cx+w, cy);
  c.closePath(); c.fill();
  if (snow) {
    c.fillStyle = 'rgba(255,255,255,0.9)';
    c.beginPath();
    c.moveTo(cx-w*0.28, cy-h*0.72); c.lineTo(cx, cy-h); c.lineTo(cx+w*0.28, cy-h*0.72);
    c.lineTo(cx+w*0.15, cy-h*0.78); c.lineTo(cx, cy-h*0.85); c.lineTo(cx-w*0.15, cy-h*0.78);
    c.closePath(); c.fill();
  }
}
function drawBuilding(c, x, y, w, h, color, windows=true) {
  c.fillStyle = color; c.fillRect(x, y-h, w, h);
  if (windows) {
    c.fillStyle = 'rgba(255,235,150,0.85)';
    const cols = Math.max(2, Math.floor(w/12));
    const rows = Math.max(2, Math.floor(h/14));
    const ww = (w-8)/cols, wh = (h-8)/rows;
    for (let i=0;i<cols;i++) for (let j=0;j<rows;j++) {
      if (Math.random() < 0.85) c.fillRect(x+4+i*ww+1, y-h+4+j*wh+1, ww-2, wh-2);
    }
  }
}
function drawPalmTree(c, x, y, size) {
  c.fillStyle = '#5d4037'; c.fillRect(x-2, y-size, 4, size);
  c.fillStyle = '#2e7d32';
  for (let i=0;i<5;i++) {
    const a = (i/5)*Math.PI*2 - Math.PI/2;
    c.beginPath();
    c.moveTo(x, y-size);
    c.quadraticCurveTo(x+Math.cos(a)*size*0.5, y-size+Math.sin(a)*size*0.3-5, x+Math.cos(a)*size*0.7, y-size+Math.sin(a)*size*0.4+5);
    c.quadraticCurveTo(x+Math.cos(a)*size*0.5, y-size+Math.sin(a)*size*0.3+8, x, y-size);
    c.fill();
  }
}
function drawPineTree(c, x, y, size, color='#2e5d3a') {
  c.fillStyle = '#4e342e'; c.fillRect(x-2, y-size*0.2, 4, size*0.2);
  c.fillStyle = color;
  for (let i=0;i<3;i++) {
    const top = y - size + i*size*0.25;
    const w = size * (0.5 + i*0.15);
    c.beginPath(); c.moveTo(x-w, top+size*0.35); c.lineTo(x, top); c.lineTo(x+w, top+size*0.35);
    c.closePath(); c.fill();
  }
}
function drawRiceTerrace(c, y0, levels, color1, color2) {
  for (let i=0;i<levels;i++) {
    const y = y0 + i*10;
    c.fillStyle = i%2===0 ? color1 : color2;
    c.beginPath(); c.moveTo(0,y);
    for (let x=0;x<=W;x+=20) { const wave = Math.sin((x+i*30)*0.008)*6; c.lineTo(x, y+wave+i*3); }
    c.lineTo(W,H); c.lineTo(0,H); c.closePath(); c.fill();
  }
}
function drawBorobudur(c, cx, cy, scale) {
  const base = scale;
  c.fillStyle = '#8d8571'; c.fillRect(cx-base, cy-base*0.25, base*2, base*0.3);
  c.fillStyle = '#a09680'; c.fillRect(cx-base*0.85, cy-base*0.5, base*1.7, base*0.25);
  c.fillStyle = '#b8ae96'; c.fillRect(cx-base*0.7, cy-base*0.7, base*1.4, base*0.2);
  c.fillStyle = '#c8bda1'; c.beginPath(); c.arc(cx, cy-base*0.75, base*0.35, Math.PI, 0); c.fill();
  c.fillStyle = '#d8cdb1'; c.beginPath(); c.arc(cx, cy-base*0.9, base*0.15, Math.PI, 0); c.fill();
  for (let i=-2;i<=2;i++) { if (i===0) continue;
    c.fillStyle = '#c8bda1'; c.beginPath(); c.arc(cx+i*base*0.35, cy-base*0.55, base*0.15, Math.PI, 0); c.fill();
  }
}
function drawPura(c, cx, cy, size) {
  c.fillStyle = '#8d6e63'; c.fillRect(cx-size*0.6, cy-size*0.15, size*1.2, size*0.15);
  const tiers = 7;
  for (let i=0;i<tiers;i++) {
    const w = size * (0.75 - i*0.08);
    const y = cy - size*0.15 - (i+1)*size*0.12;
    c.fillStyle = i%2===0 ? '#3e2723' : '#5d4037';
    c.beginPath(); c.moveTo(cx-w, y+size*0.12); c.lineTo(cx, y); c.lineTo(cx+w, y+size*0.12);
    c.closePath(); c.fill();
  }
  c.fillStyle = '#ffd54f';
  c.beginPath(); c.arc(cx, cy - size*0.15 - tiers*size*0.12 - size*0.04, size*0.06, 0, Math.PI*2); c.fill();
}
function drawRumahGadang(c, cx, cy, size) {
  c.fillStyle = '#5d4037';
  c.beginPath();
  c.moveTo(cx-size*1.3, cy-size*0.05);
  c.quadraticCurveTo(cx-size*1.4, cy-size*0.8, cx-size*0.9, cy-size*0.6);
  c.lineTo(cx-size*0.3, cy-size*0.85); c.lineTo(cx, cy-size*0.65);
  c.lineTo(cx+size*0.3, cy-size*0.85); c.lineTo(cx+size*0.9, cy-size*0.6);
