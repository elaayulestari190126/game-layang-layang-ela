function drawKitePreview(c, kite, cx, cy, size) {
  c.clearRect(0,0,60,60);
  drawKiteShape(c, kite, cx, cy, size, 0);
}

function drawKiteShape(c, kite, cx, cy, size, angle) {
  c.save();
  c.translate(cx, cy);
  c.rotate(angle);
  const s = size;

  if (kite.type === 'diamond') {
    c.fillStyle = kite.body;
    c.beginPath();
    c.moveTo(0,-s); c.lineTo(s*0.7,0); c.lineTo(0,s); c.lineTo(-s*0.7,0);
    c.closePath(); c.fill();
    c.strokeStyle = '#fff'; c.lineWidth = 2; c.stroke();
    c.strokeStyle = kite.accent; c.lineWidth = 2;
    c.beginPath();
    c.moveTo(0,-s); c.lineTo(0,s);
    c.moveTo(-s*0.7,0); c.lineTo(s*0.7,0);
    c.stroke();
    c.beginPath();
    c.moveTo(0,s);
    c.quadraticCurveTo(s*0.3,s*1.4,-s*0.1,s*1.7);
    c.stroke();
  } else if (kite.type === 'butterfly') {
    c.fillStyle = kite.body;
    c.beginPath(); c.ellipse(-s*0.55,-s*0.2,s*0.55,s*0.7,-0.5,0,Math.PI*2); c.fill();
    c.beginPath(); c.ellipse(s*0.55,-s*0.2,s*0.55,s*0.7,0.5,0,Math.PI*2); c.fill();
    c.fillStyle = kite.accent;
    c.beginPath(); c.ellipse(-s*0.5,s*0.3,s*0.4,s*0.45,0.3,0,Math.PI*2); c.fill();
    c.beginPath(); c.ellipse(s*0.5,s*0.3,s*0.4,s*0.45,-0.3,0,Math.PI*2); c.fill();
    c.fillStyle = '#5d4037';
    c.beginPath(); c.ellipse(0,0,s*0.13,s*0.7,0,0,Math.PI*2); c.fill();
  } else if (kite.type === 'bird') {
    c.fillStyle = kite.body;
    c.beginPath();
    c.moveTo(0,-s*0.9); c.lineTo(s*0.9,0); c.lineTo(s*0.3,s*0.3);
    c.lineTo(0,s*0.9); c.lineTo(-s*0.3,s*0.3); c.lineTo(-s*0.9,0);
    c.closePath(); c.fill();
    c.strokeStyle = '#fff'; c.lineWidth = 2; c.stroke();
    c.fillStyle = kite.accent;
    c.beginPath(); c.moveTo(0,-s*0.2); c.lineTo(s*0.7,0); c.lineTo(0,s*0.2); c.closePath(); c.fill();
    c.beginPath(); c.moveTo(0,-s*0.2); c.lineTo(-s*0.7,0); c.lineTo(0,s*0.2); c.closePath(); c.fill();
  } else if (kite.type === 'dragon') {
    c.fillStyle = kite.body;
    c.beginPath();
    c.moveTo(0,-s); c.lineTo(s*0.5,-s*0.3); c.lineTo(s*0.85,0);
    c.lineTo(s*0.5,s*0.4); c.lineTo(0,s);
    c.lineTo(-s*0.5,s*0.4); c.lineTo(-s*0.85,0); c.lineTo(-s*0.5,-s*0.3);
    c.closePath(); c.fill();
    c.strokeStyle = '#fff'; c.lineWidth = 2; c.stroke();
    c.fillStyle = kite.accent;
    c.beginPath(); c.arc(-s*0.25,-s*0.25,s*0.13,0,Math.PI*2); c.fill();
    c.beginPath(); c.arc(s*0.25,-s*0.25,s*0.13,0,Math.PI*2); c.fill();
    c.strokeStyle = '#ffd54f'; c.lineWidth = 2.5;
    c.beginPath();
    c.moveTo(-s*0.2,-s*0.75); c.lineTo(-s*0.35,-s*1.1);
    c.moveTo(s*0.2,-s*0.75); c.lineTo(s*0.35,-s*1.1);
    c.stroke();
  }
  c.restore();
}

function spawnObstacle() {
  const types = ['cloud','storm','balloon'];
  const t = types[Math.floor(Math.random()*types.length)];
  const size = t === 'balloon' ? 28 : 40 + Math.random()*20;
  const y = size + Math.random()*(H - size*2 - 80);
  const speed = 120 + level*22 + Math.random()*60;
  obstacles.push({ x:W+60, y:y, w:size*1.6, h:size, speed:speed, type:t, angle:Math.random()*Math.PI*2, rotSpeed:(Math.random()-0.5)*2 });
}

function spawnCollectible() {
  const isStar = Math.random() < 0.45;
  const size = isStar ? 18 : 20;
  const y = 60 + Math.random()*(H - 160);
  collectibles.push({ x:W+40, y:y, w:size*2, h:size*2, speed:110+level*15, type:isStar?'star':'coin', phase:Math.random()*Math.PI*2 });
}

function spawnParticles(x,y,color,count,spread) {
  for (let i=0;i<count;i++) {
    const a = Math.random()*Math.PI*2;
    const sp = spread*(0.3+Math.random());
    particles.push({ x,y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp-30, life:0.6+Math.random()*0.5, maxLife:0.6+Math.random()*0.5, color, size:2+Math.random()*4 });
  }
}

function showFloatingText(x,y,text,color) {
  floatingTexts.push({ x,y, text, color, life:0.9, maxLife:0.9 });
}

function update(dt) {
  gameTime += dt;
  if (levelNotifTimer > 0) { levelNotifTimer -= dt; if (levelNotifTimer <= 0) document.getElementById('levelNotif').classList.remove('show'); }
  if (invincibleTimer > 0) invincibleTimer -= dt;

  let dx = 0, dy = 0;
  if (keys['ArrowUp'] || touchDir.up) dy -= 1;
  if (keys['ArrowDown'] || touchDir.down) dy += 1;
  if (keys['ArrowLeft'] || touchDir.left) dx -= 1;
  if (keys['ArrowRight'] || touchDir.right) dx += 1;
  if (dx !== 0 && dy !== 0) { dx *= 0.707; dy *= 0.707; }

  player.x += dx * player.speed * dt;
  player.y += dy * player.speed * dt;

  const margin = 40;
  if (player.x < margin) player.x = margin;
  if (player.x > W-margin) player.x = W-margin;
  if (player.y < 70) player.y = 70;
  if (player.y > H-60) player.y = H-60;

  const targetAngle = dy * 0.35;
  player.angle += (targetAngle - player.angle) * Math.min(1, dt*8);

  if (Math.random() < 0.3) {
    particles.push({
      x: player.x-20, y: player.y + (Math.random()-0.5)*20,
      vx: -60-Math.random()*40, vy: (Math.random()-0.5)*30,
      life: 0.5, maxLife: 0.5, color: 'rgba(255,255,255,0.6)', size: 2+Math.random()*3
    });
  }

  spawnTimer -= dt;
  if (spawnTimer <= 0) {
    spawnObstacle();
    const interval = Math.max(0.45, 1.5 - level*0.1);
    spawnTimer = interval + Math.random()*0.5;
  }
  collectTimer -= dt;
  if (collectTimer <= 0) { spawnCollectible(); collectTimer = 0.9 + Math.random()*1.2; }

  cloudTimer -= dt;
  if (cloudTimer <= 0) {
    clouds.push({ x:W+60, y:Math.random()*H*0.6, scale:0.5+Math.random(), speed:15+Math.random()*25, alpha:0.3+Math.random()*0.4 });
    cloudTimer = 2+Math.random()*3;
  }
  for (let i=clouds.length-1;i>=0;i--) {
    clouds[i].x -= clouds[i].speed*dt;
    if (clouds[i].x < -150) clouds.splice(i,1);
  }

  for (let i=obstacles.length-1;i>=0;i--) {
    const o = obstacles[i];
    o.x -= o.speed*dt;
    o.angle += o.rotSpeed*dt;
    if (invincibleTimer <= 0 && rectCircleCollide(o.x-o.w/2, o.y-o.h/2, o.w, o.h, player.x, player.y, player.size*0.65)) {
      lives--; invincibleTimer = 1.5;
      SFX.hit();
      spawnParticles(player.x, player.y, '#ff5252', 16, 180);
      spawnParticles(o.x, o.y, '#ffffff', 10, 120);
      updateHUD();
      obstacles.splice(i,1);
      if (lives <= 0) { gameOver(); return; }
      continue;
    }
    if (o.x < -100) obstacles.splice(i,1);
  }

  for (let i=collectibles.length-1;i>=0;i--) {
    const c = collectibles[i];
    c.x -= c.speed*dt;
    c.phase += dt*4;
    if (rectCircleCollide(c.x-c.w/2, c.y-c.h/2, c.w, c.h, player.x, player.y, player.size*0.9)) {
      if (c.type === 'star') { score += 50; starsCollected++; SFX.star(); spawnParticles(c.x, c.y, '#ffd54f', 14, 150); showFloatingText(c.x, c.y, '+50', '#ffd54f'); }
      else { score += 25; coins++; SFX.coin(); spawnParticles(c.x, c.y, '#ffca28', 12, 140); showFloatingText(c.x, c.y, '+25', '#ffca28'); }
      collectibles.splice(i,1);
      updateHUD();
      checkLevelUp();
      continue;
    }
    if (c.x < -60) collectibles.splice(i,1);
  }

  for (let i=particles.length-1;i>=0;i--) {
    const p = particles[i];
    p.x += p.vx*dt; p.y += p.vy*dt; p.vy += 60*dt; p.life -= dt;
    if (p.life <= 0) particles.splice(i,1);
  }

  for (let i=floatingTexts.length-1;i>=0;i--) {
    const ft = floatingTexts[i];
    ft.y -= 50*dt; ft.life -= dt;
    if (ft.life <= 0) floatingTexts.splice(i,1);
  }
}

function checkLevelUp() {
  if (score >= levelTarget) {
    level++;
    levelTarget = level*400 + (level-1)*200;
    player.speed += 15;
    SFX.levelup();
    showLevelNotif('LEVEL ' + level + '!');
    spawnParticles(player.x, player.y, '#ffd54f', 24, 220);
    updateHUD();
  }
}

function rectCircleCollide(rx,ry,rw,rh,cx,cy,cr) {
  const closestX = Math.max(rx, Math.min(cx, rx+rw));
  const closestY = Math.max(ry, Math.min(cy, ry+rh));
  const dx = cx-closestX, dy = cy-closestY;
  return (dx*dx + dy*dy) < (cr*cr);
}

function render() {
  drawBackgroundByTheme(selectedProvince.theme);
  clouds.forEach(c => drawCloud(c.x, c.y, c.scale, c.alpha));

  const inGame = state === GameState.PLAYING || state === GameState.PAUSED ||
                 state === GameState.COUNTDOWN || state === GameState.GAMEOVER;
  if (inGame) {
    collectibles.forEach(c => {
      if (c.type === 'star') drawStar(c.x, c.y + Math.sin(c.phase)*4, 16, '#ffd54f', '#f9a825');
      else drawCoin(c.x, c.y + Math.sin(c.phase)*3, 18);
    });
    obstacles.forEach(o => {
      if (o.type === 'cloud' || o.type === 'storm') drawStormCloud(o);
      else if (o.type === 'balloon') drawBalloon(o);
    });
    particles.forEach(p => {
      const a = p.life / p.maxLife;
      ctx.globalAlpha = a;
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size*a, 0, Math.PI*2); ctx.fill();
    });
    ctx.globalAlpha = 1;

    drawPlayer();

    floatingTexts.forEach(ft => {
      const a = ft.life / ft.maxLife;
      ctx.globalAlpha = a;
      ctx.fillStyle = ft.color;
      ctx.font = 'bold 18px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.5)'; ctx.shadowBlur = 4;
      ctx.fillText(ft.text, ft.x, ft.y);
      ctx.shadowBlur = 0;
    });
    ctx.globalAlpha = 1;

    if (state === GameState.PLAYING || state === GameState.COUNTDOWN) drawLevelProgress();
  }
}

function drawCloud(x,y,scale,alpha) {
  ctx.save(); ctx.globalAlpha = alpha; ctx.fillStyle = '#fff';
  ctx.beginPath();
  ctx.arc(x, y, 22*scale, 0, Math.PI*2);
  ctx.arc(x+22*scale, y-8*scale, 18*scale, 0, Math.PI*2);
  ctx.arc(x+42*scale, y, 20*scale, 0, Math.PI*2);
  ctx.arc(x+20*scale, y+8*scale, 18*scale, 0, Math.PI*2);
  ctx.fill(); ctx.restore();
}

function drawStormCloud(o) {
  ctx.save(); ctx.translate(o.x, o.y); ctx.rotate(o.angle*0.3);
  ctx.fillStyle = '#546e7a';
  ctx.beginPath();
  ctx.arc(0, 0, o.w*0.45, 0, Math.PI*2);
  ctx.arc(o.w*0.35, -o.h*0.15, o.w*0.35, 0, Math.PI*2);
  ctx.arc(-o.w*0.35, -o.h*0.1, o.w*0.32, 0, Math.PI*2);
  ctx.arc(o.w*0.15, o.h*0.15, o.w*0.3, 0, Math.PI*2);
  ctx.fill();
  ctx.strokeStyle = '#ffeb3b'; ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(0, o.h*0.2); ctx.lineTo(-6, o.h*0.5); ctx.lineTo(4, o.h*0.45); ctx.lineTo(-2, o.h*0.8);
  ctx.stroke(); ctx.restore();
}

function drawBalloon(o) {
  ctx.save(); ctx.translate(o.x, o.y); ctx.rotate(o.angle*0.2);
  const r = o.w*0.4;
  ctx.fillStyle = '#ef5350';
  ctx.beginPath(); ctx.ellipse(0, -r*0.3, r, r*1.2, 0, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#ff8a80';
  ctx.beginPath(); ctx.ellipse(-r*0.3, -r*0.6, r*0.3, r*0.4, 0, 0, Math.PI*2); ctx.fill();
  ctx.strokeStyle = '#795548'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(0, r*0.85); ctx.quadraticCurveTo(r*0.2, r*1.3, 0, r*1.6); ctx.stroke();
  ctx.restore();
}

function drawStar(x,y,size,fill,stroke) {
  ctx.save(); ctx.translate(x, y); ctx.rotate(Math.sin(Date.now()*0.002)*0.3);
  ctx.shadowColor = fill; ctx.shadowBlur = 14; ctx.fillStyle = fill;
  ctx.beginPath();
  for (let i=0;i<10;i++) {
    const r = i%2===0 ? size : size*0.45;
    const a = (Math.PI/5)*i - Math.PI/2;
    if (i===0) ctx.moveTo(Math.cos(a)*r, Math.sin(a)*r);
    else ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);
  }
  ctx.closePath(); ctx.fill(); ctx.shadowBlur = 0;
  ctx.strokeStyle = stroke; ctx.lineWidth = 1.5; ctx.stroke();
  ctx.restore();
}

function drawCoin(x,y,size) {
  ctx.save(); ctx.translate(x, y);
  ctx.shadowColor = '#ffca28'; ctx.shadowBlur = 12;
  const grad = ctx.createRadialGradient(-size*0.3, -size*0.3, 2, 0, 0, size);
  grad.addColorStop(0, '#fff9c4'); grad.addColorStop(0.5, '#ffca28'); grad.addColorStop(1, '#f57f17');
  ctx.fillStyle = grad;
  ctx.beginPath(); ctx.arc(0, 0, size, 0, Math.PI*2); ctx.fill();
  ctx.shadowBlur = 0;
  ctx.strokeStyle = '#f57f17'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(0, 0, size*0.7, 0, Math.PI*2); ctx.stroke();
  ctx.fillStyle = '#f57f17';
  ctx.font = 'bold ' + Math.floor(size) + 'px Segoe UI';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText('★', 0, 1);
  ctx.restore();
}

function drawPlayer() {
  if (invincibleTimer > 0 && Math.floor(invincibleTimer*10)%2===0) ctx.globalAlpha = 0.35;
  else ctx.globalAlpha = 1;

  ctx.save();
  ctx.globalAlpha = 0.15 * (invincibleTimer>0 ? 0.5 : 1);
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.ellipse(player.x, player.y + player.size*1.4, player.size*0.8, player.size*0.25, 0, 0, Math.PI*2);
  ctx.fill();
  ctx.restore();

  ctx.strokeStyle = 'rgba(255,255,255,0.4)'; ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(player.x+10, player.y+10);
  ctx.quadraticCurveTo(player.x+60, player.y+80, player.x-40, player.y+140);
  ctx.stroke();

  const kite = KITES[selectedKite];
  drawKiteShape(ctx, kite, player.x, player.y, player.size, player.angle);
  ctx.globalAlpha = 1;
}

function drawLevelProgress() {
  const barW = 180, barH = 10;
  const x = W/2 - barW/2, y = 56;
  ctx.save();
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  ctx.beginPath(); ctx.roundRect(x-4, y-4, barW+8, barH+8, 8); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.2)';
  ctx.beginPath(); ctx.roundRect(x, y, barW, barH, 5); ctx.fill();
  const prevTarget = level === 1 ? 0 : (level-1)*400 + (level-2)*200;
  const progress = Math.min(1, (score-prevTarget) / (levelTarget-prevTarget));
  const grad = ctx.createLinearGradient(x, 0, x+barW, 0);
  grad.addColorStop(0, '#ffd54f'); grad.addColorStop(1, '#ff8f00');
  ctx.fillStyle = grad;
  ctx.beginPath(); ctx.roundRect(x, y, barW*progress, barH, 5); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 11px Segoe UI';
  ctx.textAlign = 'center';
  ctx.fillText('LEVEL ' + level + '  —  ' + score + ' / ' + levelTarget, W/2, y + barH + 14);
  ctx.restore();
}

function gameLoop(timestamp) {
  const dt = Math.min(0.05, (timestamp - lastTime)/1000);
  lastTime = timestamp;
  if (state === GameState.PLAYING) update(dt);
  render();
  requestAnimationFrame(gameLoop);
}

