/* =========================================================
   GAME LOGIC
   ========================================================= */
function initClouds() {
  clouds = [];
  for (let i=0;i<6;i++) clouds.push({ x: Math.random()*W, y: Math.random()*H*0.7, scale: 0.5+Math.random(), speed: 8+Math.random()*20, alpha: 0.4+Math.random()*0.4 });
}

function initGame() {
  player = { x:130, y:H/2, vx:0, vy:0, size:34, speed:320, angle:0 };
  obstacles = []; collectibles = []; particles = []; floatingTexts = [];
  initClouds();
  score = 0; coins = 0; starsCollected = 0;
  lives = 3; level = 1; levelTarget = 400;
  spawnTimer = 0; collectTimer = 0; cloudTimer = 0;
  gameTime = 0; invincibleTimer = 0;
  keys = {};
  touchDir = { up:false, down:false, left:false, right:false };
  updateHUD();
}

function updateHUD() {
  document.getElementById('hudLevel').textContent = level;
  document.getElementById('hudScore').textContent = score;
  document.getElementById('hudCoins').textContent = coins;
  document.getElementById('hudStars').textContent = starsCollected;
  document.getElementById('hudProvince').textContent = selectedProvince.name.toUpperCase();
  let h = '';
  for (let i=0;i<3;i++) h += i<lives ? '<span class="heart-full">❤️</span>' : '<span class="heart-empty">🖤</span>';
  document.getElementById('hearts').innerHTML = h;
}

function hideAllOverlays() {
  document.querySelectorAll('.overlay').forEach(o => o.classList.add('hidden'));
  document.getElementById('hud').classList.remove('active');
  document.getElementById('dpad').classList.remove('active');
  document.getElementById('pauseBtn').classList.remove('active');
  document.getElementById('countdownOverlay').classList.remove('active');
}

function showMenu() { hideAllOverlays(); document.getElementById('mainMenu').classList.remove('hidden'); state = GameState.MENU; }
function showProvinces() {
  hideAllOverlays();
  document.getElementById('provincesMenu').classList.remove('hidden');
  state = GameState.PROVINCES;
  renderRegionTabs();
  renderProvinceGrid();
  renderKiteGridCompact();
  updateSelectedInfo();
  updateComboSummary();
}
function showHow() { hideAllOverlays(); document.getElementById('howMenu').classList.remove('hidden'); state = GameState.HOW; }
function showSettings() {
  hideAllOverlays();
  document.getElementById('settingsMenu').classList.remove('hidden');
  state = GameState.SETTINGS;
  document.getElementById('toggleMusic').checked = !Music.muted;
  document.getElementById('toggleSFX').checked = !SFX.muted;
  document.getElementById('toggleFact').checked = showFactEnabled;
}

function startGame() {
  hideAllOverlays();
  initGame();
  state = GameState.PLAYING;
  document.getElementById('hud').classList.add('active');
  document.getElementById('dpad').classList.add('active');
  document.getElementById('pauseBtn').classList.add('active');
  showLevelNotif('LEVEL 1');
  lastTime = performance.now();

  if (showFactEnabled && selectedProvince) {
    setTimeout(() => {
      if (state === GameState.PLAYING) pauseGameForFact();
    }, 500);
  }
}

function pauseGameForFact() {
  if (state !== GameState.PLAYING) return;
  state = GameState.PAUSED;
  gamePausedByFact = true;
  document.getElementById('factProvince').textContent = selectedProvince.name;
  document.getElementById('factText').textContent = selectedProvince.fact;
  document.getElementById('factPopup').classList.add('show');
  document.getElementById('pauseBtn').classList.remove('active');
}

function closeFactPopup() {
  document.getElementById('factPopup').classList.remove('show');
  if (gamePausedByFact) {
    gamePausedByFact = false;
    state = GameState.PLAYING;
    document.getElementById('pauseBtn').classList.add('active');
    lastTime = performance.now();
  }
}

function pauseGame() {
  if (state !== GameState.PLAYING) return;
  state = GameState.PAUSED;
  SFX.pause();
  document.getElementById('pauseScore').textContent = score;
  document.getElementById('pauseLevel').textContent = level;
  document.getElementById('pauseLives').textContent = lives;
  document.getElementById('pauseOverlay').classList.remove('hidden');
  document.getElementById('pauseBtn').classList.remove('active');
}

function resumeGame() {
  if (state !== GameState.PAUSED) return;
  SFX.resumeSound();
  document.getElementById('pauseOverlay').classList.add('hidden');
  startCountdown();
}

function startCountdown() {
  state = GameState.COUNTDOWN;
  const overlay = document.getElementById('countdownOverlay');
  const numEl = document.getElementById('countdownNum');
  overlay.classList.add('active');

  let count = 3;
  numEl.textContent = count;
  SFX.tick();
  numEl.style.animation = 'none';
  void numEl.offsetWidth;
  numEl.style.animation = 'countdownPop 0.85s ease-out';

  const tick = () => {
    count--;
    if (count > 0) {
      numEl.textContent = count;
      SFX.tick();
      numEl.style.animation = 'none';
      void numEl.offsetWidth;
      numEl.style.animation = 'countdownPop 0.85s ease-out';
      setTimeout(tick, 850);
    } else {
      numEl.textContent = 'GO!';
      SFX.go();
      numEl.style.animation = 'none';
      void numEl.offsetWidth;
      numEl.style.animation = 'countdownPop 0.85s ease-out';
      setTimeout(() => {
        overlay.classList.remove('active');
        state = GameState.PLAYING;
        document.getElementById('pauseBtn').classList.add('active');
        lastTime = performance.now();
      }, 700);
    }
  };
  setTimeout(tick, 850);
}

function restartGame() {
  SFX.click();
  document.getElementById('pauseOverlay').classList.add('hidden');
  document.getElementById('gameOverOverlay').classList.add('hidden');
  startGame();
}

function toMainMenu() {
  SFX.back();
  document.getElementById('pauseOverlay').classList.add('hidden');
  document.getElementById('gameOverOverlay').classList.add('hidden');
  showMenu();
}

function gameOver() {
  state = GameState.GAMEOVER;
  SFX.gameover();
  document.getElementById('finalScore').textContent = score;
  document.getElementById('finalLevel').textContent = level;
  document.getElementById('finalCoins').textContent = coins;
  document.getElementById('finalStars').textContent = starsCollected;
  document.getElementById('gameOverOverlay').classList.remove('hidden');
  document.getElementById('hud').classList.remove('active');
  document.getElementById('dpad').classList.remove('active');
  document.getElementById('pauseBtn').classList.remove('active');
}

