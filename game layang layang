function drawCandi(c, cx, cy, size) {
  const tiers = 4;
  c.fillStyle = '#5d4037'; c.fillRect(cx-size*0.5, cy-size*0.1, size, size*0.15);
  for (let i=0;i<tiers;i++) {
    const w = size * (0.45 - i*0.08);
    const y = cy - size*0.1 - (i+1)*size*0.18;
    c.fillStyle = i%2===0 ? '#6d4c41' : '#8d6e63';
    c.fillRect(cx-w, y, w*2, size*0.18);
  }
  c.fillStyle = '#a1887f';
  c.beginPath();
  c.moveTo(cx-size*0.1, cy-size*0.1 - tiers*size*0.18);
  c.lineTo(cx, cy-size*0.1 - tiers*size*0.18 - size*0.2);
  c.lineTo(cx+size*0.1, cy-size*0.1 - tiers*size*0.18);
  c.closePath(); c.fill();
}
