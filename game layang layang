  #gameOverOverlay { background: rgba(20,0,0,0.82); backdrop-filter: blur(4px); }
  .go-title { font-size: clamp(28px, 4.5vw, 48px); font-weight: 900; color: #ff5252; text-shadow: 0 3px 0 #7a0000, 0 6px 16px rgba(0,0,0,0.6); margin-bottom: 6px; }
