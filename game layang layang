  }
</style>
</head>
<body>
<div id="gameContainer">
  <canvas id="gameCanvas" width="900" height="540"></canvas>
  <button id="pauseBtn">PAUSE</button>
  <button id="fullscreenBtn" title="Fullscreen">⛶</button>

  <div id="hud">
    <div class="hud-left">
      <div class="hud-item"><span class="lbl">LEVEL</span> <span class="val" id="hudLevel">1</span></div>
      <div class="hud-item"><span class="lbl">SKOR</span> <span class="val" id="hudScore">0</span></div>
    </div>
    <div class="hud-right">
      <div class="hud-province" id="hudProvince">JAWA BARAT</div>
      <div class="hud-item" id="hearts">❤️❤️❤️</div>
      <div class="hud-item"><span class="lbl">KOIN</span> <span class="val" id="hudCoins">0</span></div>
      <div class="hud-item"><span class="lbl">BINTANG</span> <span class="val" id="hudStars">0</span></div>
    </div>
  </div>

  <div id="dpad">
    <div class="dpad-row"><div class="dpad-btn" data-dir="up">⬆️</div></div>
    <div class="dpad-row">
      <div class="dpad-btn" data-dir="left">⬅️</div>
      <div class="dpad-btn" data-dir="down">⬇️</div>
      <div class="dpad-btn" data-dir="right">➡️</div>
    </div>
  </div>

  <div id="levelNotif"></div>

  <div id="factPopup">
    <div class="fact-eyebrow">TAHUKAH KAMU</div>
    <div class="fact-province" id="factProvince">Bali</div>
    <div class="fact-text" id="factText">...</div>
    <button class="fact-close" id="factClose">MENGERTI</button>
  </div>

  <div id="countdownOverlay"><div id="countdownNum">3</div></div>

  <div class="overlay" id="mainMenu">
    <div class="game-logo">JELAJAH<br>LAYANG-LAYANG<br>NUSANTARA</div>
    <div class="logo-sub">PETUALANGAN DI 34 PROVINSI INDONESIA</div>
    <button class="menu-btn" id="btnPlay">MULAI BERMAIN</button>
    <button class="menu-btn blue" id="btnProvinces">MULAI PETUALANGAN</button>
    <button class="menu-btn green" id="btnHow">CARA BERMAIN</button>
    <button class="menu-btn gray" id="btnSettings">PENGATURAN</button>
    <div class="small-note">Jelajahi langit dari Sabang sampai Merauke</div>
  </div>

  <div class="overlay hidden" id="provincesMenu">
    <div class="panel">
      <div class="panel-header">
        <div class="eyebrow">PERSIAPAN TERBANG</div>
        <h2>Pilih Provinsi & Layang-Layang</h2>
      </div>

      <div class="combo-summary">
        <div class="combo-item">
          <div class="combo-icon"><canvas id="comboKitePreview" width="80" height="80"></canvas></div>
          <div class="combo-text">
            <b id="comboKiteName">Layang Tradisional</b>
            <span>Karakter terpilih</span>
          </div>
        </div>
        <div class="combo-divider"></div>
        <div class="combo-item">
          <div class="combo-icon"><canvas id="comboProvPreview" width="80" height="80"></canvas></div>
          <div class="combo-text">
            <b id="comboProvName">Jawa Barat</b>
            <span>Provinsi terpilih</span>
          </div>
        </div>
      </div>

      <div class="section-label">
        <span>① Pilih Layang-Layang</span>
        <span class="section-hint">4 karakter</span>
      </div>
      <div class="kite-grid-compact" id="kiteGridCompact"></div>

      <div class="section-label">
        <span>② Pilih Provinsi</span>
        <span class="section-hint">34 provinsi Indonesia</span>
      </div>
      <div class="region-tabs" id="regionTabs"></div>
      <div class="province-grid-compact" id="provinceGrid"></div>

      <div class="selected-info" id="selectedInfo">
        <div class="info-title" id="infoTitle">Jawa Barat</div>
        <div class="info-desc" id="infoDesc">Gunung & kebun teh hijau</div>
        <div class="info-fact" id="infoFact"></div>
      </div>

      <div class="btn-row">
        <button class="btn-sm yellow" id="btnProvincePlay">MULAI BERMAIN</button>
        <button class="btn-sm red" id="btnProvinceBack">KEMBALI</button>
      </div>
    </div>
  </div>

  <div class="overlay hidden" id="settingsMenu">
    <div class="panel" style="max-width:520px;">
      <div class="panel-header">
        <div class="eyebrow">PREFERENSI</div>
        <h2>Pengaturan</h2>
      </div>
      <div class="settings-list">
        <div class="settings-item">
          <div class="settings-info"><b>Musik Latar</b><span>Musik "Cublak-Cublak Suweng" — lagu daerah Jawa</span></div>
          <label class="toggle"><input type="checkbox" id="toggleMusic" checked><span class="slider"></span></label>
        </div>
        <div class="settings-item">
          <div class="settings-info"><b>Efek Suara</b><span>Suara tombol, koin, bintang, dan lainnya</span></div>
          <label class="toggle"><input type="checkbox" id="toggleSFX" checked><span class="slider"></span></label>
        </div>
        <div class="settings-item">
          <div class="settings-info"><b>Fakta Provinsi</b><span>Tampilkan fakta unik saat mulai bermain</span></div>
          <label class="toggle"><input type="checkbox" id="toggleFact" checked><span class="slider"></span></label>
        </div>
      </div>
      <div class="note-box"><strong>INFO</strong>Pengaturan ini berlaku langsung pada permainan.</div>
      <div class="btn-row"><button class="btn-sm blue2" id="btnSettingsBack">KEMBALI KE MENU</button></div>
    </div>
  </div>

  <div class="overlay hidden" id="howMenu">
    <div class="panel">
      <div class="panel-header"><div class="eyebrow">PANDUAN</div><h2>Cara Bermain</h2></div>
      <div class="guide-grid">
        <div class="guide-block"><div class="guide-num">1</div><div class="guide-body"><h4>Kontrol Permainan</h4><p>Gunakan tombol arah untuk mengendalikan layang-layang di langit.</p><div class="kb-row"><span class="kb-key">↑</span><span class="kb-key">↓</span><span class="kb-key">←</span><span class="kb-key">→</span></div></div></div>
        <div class="guide-block"><div class="guide-num">2</div><div class="guide-body"><h4>Perangkat Sentuh</h4><p>Pada layar HP, gunakan tombol arah virtual di bagian bawah layar.</p></div></div>
        <div class="guide-block"><div class="guide-num">3</div><div class="guide-body"><h4>Pilih Provinsi</h4><p>Setiap provinsi memiliki latar langit dan ciri khas yang berbeda — dari Sabang sampai Merauke.</p></div></div>
        <div class="guide-block"><div class="guide-num">4</div><div class="guide-body"><h4>Jeda Permainan</h4><p>Tekan tombol PAUSE atau tombol ESC / P pada keyboard untuk menghentikan permainan sementara.</p></div></div>
      </div>
      <div class="score-legend">
        <div class="legend-item"><div class="legend-icon star">★</div><span class="legend-title">Bintang</span><span class="legend-desc">+50 poin</span></div>
        <div class="legend-item"><div class="legend-icon coin">$</div><span class="legend-title">Koin</span><span class="legend-desc">+25 poin</span></div>
        <div class="legend-item"><div class="legend-icon danger">!</div><span class="legend-title">Rintangan</span><span class="legend-desc">-1 nyawa</span></div>
      </div>
      <div class="note-box"><strong>TIPS</strong>Tetap di bagian tengah layar agar memiliki ruang manuver lebih luas. Prioritaskan bintang emas karena nilainya paling besar.</div>
      <div class="btn-row"><button class="btn-sm blue2" id="btnHowBack">KEMBALI KE MENU</button></div>
    </div>
  </div>

  <div class="overlay hidden" id="pauseOverlay">
    <div class="pause-panel">
      <h2>GAME DIJEDA</h2>
      <div class="pause-sub">Layang-layangmu beristirahat sejenak di langit</div>
      <div class="pause-stats">
        <div class="pause-stat"><div class="ps-val" id="pauseScore">0</div><div class="ps-lbl">SKOR</div></div>
        <div class="pause-stat"><div class="ps-val" id="pauseLevel">1</div><div class="ps-lbl">LEVEL</div></div>
        <div class="pause-stat"><div class="ps-val" id="pauseLives">3</div><div class="ps-lbl">NYAWA</div></div>
      </div>
      <button class="pause-btn resume" id="btnResume">LANJUTKAN BERMAIN</button>
      <button class="pause-btn retry" id="btnRestart">ULANGI DARI AWAL</button>
      <button class="pause-btn quit" id="btnToMenu">KEMBALI KE MENU UTAMA</button>
      <div style="font-size:10px;color:#90caf9;margin-top:10px;">Tekan <b style="color:#ffd54f;">ESC</b> / <b style="color:#ffd54f;">P</b> untuk lanjut cepat</div>
    </div>
  </div>

  <div class="overlay hidden" id="gameOverOverlay">
    <div class="panel" style="max-width:440px;text-align:center;">
      <div class="go-title">GAME OVER</div>
      <div class="go-sub">Layang-layangmu jatuh. Coba lagi untuk terbang lebih tinggi.</div>
      <div style="font-size:15px;color:#fff;margin-bottom:5px;">Skor Akhir: <b id="finalScore" style="color:#ffd54f;font-size:22px;">0</b></div>
      <div style="font-size:12.5px;color:#9fc4e8;margin-bottom:18px;">Level: <b id="finalLevel">1</b> | Koin: <b id="finalCoins">0</b> | Bintang: <b id="finalStars">0</b></div>
      <div class="btn-row" style="flex-direction:column;">
        <button class="btn-sm green2" id="btnGoRestart" style="width:100%;">MAIN LAGI</button>
        <button class="btn-sm blue2" id="btnGoChooseProvince" style="width:100%;">GANTI PROVINSI</button>
        <button class="btn-sm red" id="btnGoMenu" style="width:100%;">MENU UTAMA</button>
      </div>
    </div>
  </div>
</div>

<script>
/* =========================================================
   JELAJAH LAYANG-LAYANG NUSANTARA
   ========================================================= */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;

const GameState = { MENU:'menu', PROVINCES:'provinces', HOW:'how', SETTINGS:'settings', PLAYING:'playing', PAUSED:'paused', COUNTDOWN:'countdown', GAMEOVER:'gameover' };
let state = GameState.MENU;

/* ================= 34 PROVINSI ================= */
const PROVINCES = [
  {id:'aceh',name:'Aceh',region:'Sumatera',theme:'aceh',desc:'Serambi Mekkah & Masjid Raya Baiturrahman',fact:'Aceh dikenal sebagai "Serambi Mekkah" karena menjadi pintu masuk Islam pertama di Indonesia. Masjid Raya Baiturrahman berdiri kokoh sejak abad ke-17 dan selamat dari tsunami 2004.'},
  {id:'sumut',name:'Sumatera Utara',region:'Sumatera',theme:'sumut',desc:'Danau Toba & rumah adat Batak',fact:'Danau Toba adalah danau vulkanik terbesar di dunia, terbentuk dari letusan supervolcano 74.000 tahun lalu. Di tengahnya ada Pulau Samosir — pulau dalam pulau.'},
  {id:'sumbar',name:'Sumatera Barat',region:'Sumatera',theme:'sumbar',desc:'Rumah Gadang & budaya Minangkabau',fact:'Sumatera Barat satu-satunya provinsi di Indonesia yang menganut sistem matrilineal. Rumah Gadang dengan atap melengkung seperti tanduk kerbau menjadi ikon budaya Minangkabau.'},
  {id:'riau',name:'Riau',region:'Sumatera',theme:'riau',desc:'Sungai Siak & hutan tropis',fact:'Riau memiliki Sungai Siak, sungai terdalam di Indonesia dengan kedalaman mencapai 30 meter. Provinsi ini juga pusat kebudayaan Melayu di Sumatera.'},
  {id:'kepri',name:'Kepulauan Riau',region:'Sumatera',theme:'kepri',desc:'Gugusan pulau di Selat Malaka',fact:'Kepulauan Riau terdiri dari 2.408 pulau — 96% di antaranya belum berpenghuni. Terletak di jalur pelayaran internasional Selat Malaka.'},
  {id:'jambi',name:'Jambi',region:'Sumatera',theme:'jambi',desc:'Candi Muaro Jambi & Sungai Batanghari',fact:'Jambi memiliki Candi Muaro Jambi, kompleks candi Buddha terluas di Asia Tenggara. Luasnya 12 km persegi dan diperkirakan pusat pendidikan Buddha abad ke-7 hingga ke-12.'},
  {id:'sumsel',name:'Sumatera Selatan',region:'Sumatera',theme:'sumsel',desc:'Jembatan Ampera & Sungai Musi',fact:'Jembatan Ampera di Palembang adalah ikon provinsi ini. Bagian tengah jembatan pernah bisa diangkat untuk kapal besar melintas — meski saat ini sudah tidak aktif.'},
  {id:'babel',name:'Bangka Belitung',region:'Sumatera',theme:'babel',desc:'Pantai granit & pulau Laskar Pelangi',fact:'Bangka Belitung punya pantai dengan batu granit raksasa seperti Pantai Tanjung Tinggi. Pulau Belitung terkenal lewat novel dan film "Laskar Pelangi".'},
  {id:'bengkulu',name:'Bengkulu',region:'Sumatera',theme:'bengkulu',desc:'Rafflesia Arnoldii & pantai panjang',fact:'Bengkulu adalah tempat pertama kali bunga Rafflesia Arnoldii ditemukan oleh Sir Stamford Raffles pada 1818. Bunga ini terbesar di dunia dengan diameter mencapai 1 meter.'},
  {id:'lampung',name:'Lampung',region:'Sumatera',theme:'lampung',desc:'Gunung Krakatau & gajah Sumatra',fact:'Lampung dikenal dengan Gunung Krakatau. Letusannya pada 1883 menjadi salah satu yang paling dahsyat dalam sejarah — suaranya terdengar hingga Australia.'},
  {id:'jakarta',name:'DKI Jakarta',region:'Jawa',theme:'jakarta',desc:'Monas & gedung pencakar langit',fact:'Jakarta adalah kota terpadat di Indonesia dan pernah menjadi pusat ekonomi Asia Tenggara. Menara Monas setinggi 132 meter dihiasi lidah api berlapis emas 35 kilogram pemberian Jepang.'},
  {id:'jabar',name:'Jawa Barat',region:'Jawa',theme:'jabar',desc:'Gunung & kebun teh hijau',fact:'Jawa Barat dijuluki "Paris van Java" sejak zaman kolonial karena udaranya sejuk. Di sini terdapat Gunung Tangkuban Perahu yang legendaris dengan kawah aktifnya.'},
  {id:'jateng',name:'Jawa Tengah',region:'Jawa',theme:'jateng',desc:'Candi Borobudur & Prambanan',fact:'Jawa Tengah adalah rumah bagi Candi Borobudur — candi Buddha terbesar di dunia dan Situs Warisan Dunia UNESCO. Terdiri dari 2.672 panel relief dan 504 arca Buddha.'},
  {id:'diy',name:'DI Yogyakarta',region:'Jawa',theme:'diy',desc:'Kraton & Malioboro',fact:'Yogyakarta satu-satunya provinsi di Indonesia yang dipimpin oleh Sultan. Keraton Yogyakarta masih aktif hingga kini sebagai pusat kebudayaan Jawa.'},
  {id:'jatim',name:'Jawa Timur',region:'Jawa',theme:'jatim',desc:'Gunung Bromo & Tumpak Sewu',fact:'Jawa Timur punya Gunung Bromo dengan lautan pasir 10 km — wisata sunrise paling ikonik di Indonesia. Juga ada Air Terjun Tumpak Sewu yang dijuluki "Niagara-nya Indonesia".'},
