  #dpad { position: absolute; bottom: clamp(10px, 2vh, 20px); left: 50%; transform: translateX(-50%); display: none; z-index: 6; gap: clamp(3px, 0.5vh, 6px); flex-direction: column; align-items: center; pointer-events: none; }
