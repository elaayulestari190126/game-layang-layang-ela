  c.arc(x, y, size*0.5, 0, Math.PI*2);
  c.arc(x+size*0.45, y-size*0.2, size*0.4, 0, Math.PI*2);
  c.arc(x+size*0.85, y, size*0.45, 0, Math.PI*2);
  c.fill(); c.restore();
}

