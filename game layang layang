  .dpad-btn { width: clamp(42px, 6vw, 68px); height: clamp(42px, 6vw, 68px); border-radius: clamp(8px, 1vw, 14px); background: rgba(255,255,255,0.25); border: 2px solid rgba(255,255,255,0.5); color: #fff; font-size: clamp(18px, 2.2vw, 28px); display: flex; justify-content: center; align-items: center; pointer-events: auto; cursor: pointer; backdrop-filter: blur(2px); transition: background 0.1s; touch-action: none; }
  .dpad-btn:active, .dpad-btn.pressed { background: rgba(255,213,79,0.6); }

  #levelNotif { position: absolute; top: 40%; left: 50%; transform: translate(-50%,-50%); font-size: clamp(24px, 3.5vw, 44px); font-weight: 900; color: #fff; text-shadow: 0 0 20px #ffd54f, 0 4px 10px rgba(0,0,0,0.7); z-index: 20; pointer-events: none; opacity: 0; transition: opacity 0.4s; text-align: center; padding: 0 10px; }
  #levelNotif.show { opacity: 1; }
  .small-note { font-size: clamp(9px, 1vw, 12px); color: #9fc4e8; margin-top: clamp(4px, 0.8vh, 8px); text-align: center; padding: 0 10px; }

  /* HP Portrait */
  @media (max-width: 700px) and (orientation: portrait) {
    .game-logo { font-size: clamp(22px, 7vw, 40px); }
