    .menu-btn { width: clamp(200px, 75vw, 340px); padding: clamp(9px, 1.4vh, 14px) 0; font-size: clamp(13px, 3.5vw, 17px); margin: 3px 0; }
    .panel { padding: 16px; width: 95%; }
    .panel-header h2 { font-size: 17px; }
    .panel-header .eyebrow { font-size: 8px; letter-spacing: 2px; }
    .guide-grid { grid-template-columns: 1fr; }
