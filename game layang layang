    .guide-body h4 { font-size: 11px; }
    .guide-body p { font-size: 9.5px; }
    .kite-grid-compact { max-width: 100%; }
    .kite-card-mini canvas { width: 32px; height: 32px; }
    .kite-card-mini .kite-name-mini { font-size: 9px; }
    .province-grid-compact { grid-template-columns: repeat(6, 1fr); max-height: 120px; gap: 4px; }
    .province-card canvas { height: 34px; }
    .province-card .prov-name { font-size: 8.5px; padding: 2px; }
    .combo-summary { padding: 6px 10px; margin-bottom: 5px; }
    .combo-summary .combo-icon { width: 34px; height: 34px; }
    .combo-summary .combo-text b { font-size: 10px; }
    .combo-summary .combo-text span { font-size: 8.5px; }
    .selected-info { padding: 6px 10px; margin-bottom: 6px; font-size: 10px; }
    .selected-info .info-title { font-size: 11px; }
    .selected-info .info-fact { font-size: 9px; }
    .btn-sm { padding: 6px 16px; font-size: 11px; }
    .section-label { margin: 5px 0 4px; font-size: 9px; }
    .score-legend { margin-bottom: 8px; }
    .legend-item { padding: 6px 4px; }
    .legend-icon { width: 20px; height: 20px; font-size: 10px; }
    .legend-title { font-size: 9px; }
    .legend-desc { font-size: 8.5px; }
    .settings-item { padding: 8px 12px; }
    .settings-info b { font-size: 11px; }
    .settings-info span { font-size: 9px; }
    .toggle { width: 42px; height: 22px; }
    #pauseBtn { padding: 5px 12px; font-size: 11px; top: 6px; }
    #fullscreenBtn { width: 30px; height: 30px; font-size: 14px; top: 6px; right: 8px; }
    .dpad-btn { width: 46px; height: 46px; font-size: 18px; }
    #dpad { bottom: 6px; }
    .hud-item { padding: 2px 8px; font-size: 10.5px; }
    .hud-item .lbl { font-size: 8.5px; }
    .hud-item .val { font-size: 12px; }
    .hud-province { font-size: 8.5px; }
    #hearts { font-size: 13px; }
    #countdownNum { font-size: 80px; }
    .pause-panel { padding: 16px 20px; max-width: 420px; }
    .pause-panel h2 { font-size: 18px; }
    .pause-btn { padding: 8px 0; font-size: 11.5px; }
